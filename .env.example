# Merchant-owned channel credentials and upstream callback URLs are configured
# per channel instance in the merchant console, not in platform env vars.

# ── Security hardening (added 2026-07-26) ─────────────────────────────────────
# Auth token for internal endpoints (/api/internal/*). Set a long random value
# in production; server-to-server callers pass it as the `x-internal-token`
# header. When unset, those endpoints require an authenticated SUPER_ADMIN.
NOVAPAY_INTERNAL_API_TOKEN=""
# Trusted client-IP header that your edge always overwrites. The production
# compose/nginx config injects x-novapay-client-ip; never point this directly at
# a client-controlled header without an equivalent edge overwrite rule.
TRUSTED_CLIENT_IP_HEADER=""
# Number of trusted proxies in front of the app (picks the right X-Forwarded-For
# hop when no trusted header is set). Default 1.
TRUSTED_PROXY_COUNT="1"
# Successful notifications must include the paid amount outside development and
# test. Set to 0 only as a temporary compatibility exception for a legacy channel.
NOVAPAY_REQUIRE_NOTIFICATION_AMOUNT=""
# EasyPay requests require a fresh timestamp outside development and test.
# Set to 0 only while migrating a legacy caller that cannot send timestamps.
EASYPAY_REQUIRE_TIMESTAMP=""
# EASYPAY_TIMESTAMP_MAX_AGE_SECONDS="300"
# Set to 1 ONLY in a controlled env to allow installing plugin bundles from a
# registry source with no trust public key (unsigned). Default = refuse.
NOVAPAY_ALLOW_UNSIGNED_PLUGINS=""
# Third-party REMOTE_SIGNED runtime code is disabled by default. Official
# novapay.* entries always use the implementation built into the app image.
# Setting this to 1 executes third-party plugin code in the main process and is
# a temporary, unsafe compatibility escape hatch only.
NOVAPAY_ALLOW_UNSAFE_REMOTE_PLUGIN_RUNTIME=""
