generator client {
  provider   = "prisma-client"
  output     = "../generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// Phase 1 subset of the Registry schema. Phase 2/3/4 will introduce
// DeveloperToken / Category / PluginCategoryLink / PluginPricingHistory /
// Order / License / LicenseRevocation / PayoutAccount / PayoutRequest
// (and their enums). Models below are intentionally kept self-consistent
// without forward references to those phases.
// =====================================================================
// Phase 3: Paid / License / Payout models
// =====================================================================

enum OrderState {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum LicenseState {
  ISSUED
  REVOKED
  EXPIRED
}

enum PricingPlanKind {
  FREE
  PER_INSTANCE_ONE_TIME
  PER_MERCHANT_SUBSCRIPTION
  PER_USAGE
}

enum PayoutState {
  PENDING_REVIEW
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum PayoutAccountStatus {
  PENDING_VERIFICATION
  VERIFIED
  SUSPENDED
}

enum DeveloperAccountStatus {
  EMAIL_UNVERIFIED
  ACTIVE
  SUSPENDED
}

enum PluginPricingMode {
  FREE
  PAID
}

enum ReviewState {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  PUBLISHED
  DEPRECATED
  TAKEN_DOWN
}

enum SigningKeyStatus {
  ACTIVE
  RETIRED
}

model Developer {
  id                String                 @id @default(cuid())
  email             String                 @unique
  passwordHash      String
  displayName       String
  contact           Json
  status            DeveloperAccountStatus @default(EMAIL_UNVERIFIED)
  balanceCents      Int                    @default(0)
  novapayInstanceId String?
  novapayMerchantId String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  plugins        PluginRecord[]
  auditLogs      AuditLog[]      @relation("AuditLogActorDeveloper")
  ledgerEntries  RegistryLedgerEntry[]
  orders         Order[]
  licenses       License[]
  payoutAccounts PayoutAccount[]
  payoutRequests PayoutRequest[]

  @@index([status, createdAt])
}

model PluginRecord {
  id               String            @id @default(cuid())
  developerId      String
  developer        Developer         @relation(fields: [developerId], references: [id], onDelete: Restrict)
  slug             String            @unique
  remotePluginId   String            @unique
  kind             String
  channelCode      String            @unique
  providerKey      String
  packageName      String
  displayName      String
  vendor           String
  description      String            @db.Text
  pricingMode      PluginPricingMode
  pricingPlanKind  PricingPlanKind?  // For PAID: PER_INSTANCE_ONE_TIME, PER_MERCHANT_SUBSCRIPTION, PER_USAGE
  priceAmountCents Int?              // Price in cents, e.g., 2999 = $29.99
  priceCurrency    String?           // Currency code, e.g., "CNY", "USD"
  priceLabel       String?           // Legacy field, keep for compatibility
  publishedVersion String?
  latestVersion    String?
  visible          Boolean           @default(true)
  takenDown        Boolean           @default(false)
  takenDownReason  String?
  featured         Boolean           @default(false)
  metadata         Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  versions        PluginVersion[]
  reviewWorkflows ReviewWorkflow[]
  orders          Order[]
  licenses        License[]
  pricingHistory  PluginPricingHistory[]

  @@index([developerId, createdAt])
  @@index([visible, takenDown, featured])
  @@index([pricingMode, pricingPlanKind])
}

model PluginVersion {
  id           String       @id @default(cuid())
  pluginId     String
  plugin       PluginRecord @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  version      String
  manifestJson Json
  manifestRaw  String       @db.Text
  reviewState  ReviewState  @default(DRAFT)
  reviewerId   String?
  reviewNote   String?      @db.Text
  rejectReason String?      @db.Text
  publishedAt  DateTime?
  capabilities Json
  assetId      String       @unique
  asset        PluginAsset  @relation(fields: [assetId], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  reviewWorkflow ReviewWorkflow?

  @@unique([pluginId, version])
  @@index([reviewState, createdAt])
}

model PluginAsset {
  id             String     @id @default(cuid())
  sha256         String     @unique
  sizeBytes      Int
  contentType    String
  storageKey     String
  signature      String
  signatureKeyId String
  signingKey     SigningKey @relation(fields: [signatureKeyId], references: [keyId])
  createdAt      DateTime   @default(now())

  versions PluginVersion[]
}

model SigningKey {
  keyId     String           @id
  alg       String
  publicKey String
  kmsKeyArn String?
  status    SigningKeyStatus @default(ACTIVE)
  notBefore DateTime
  notAfter  DateTime
  createdAt DateTime         @default(now())

  assets PluginAsset[]

  @@index([status, notAfter])
}

model ReviewWorkflow {
  id           String        @id @default(cuid())
  pluginId     String
  plugin       PluginRecord  @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  versionId    String        @unique
  version      PluginVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  claimedById  String?
  decision     String?
  decisionNote String?       @db.Text
  findings     Json
  appealNote   String?       @db.Text
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([claimedById, updatedAt])
}

model AuditLog {
  id             String     @id @default(cuid())
  actorType      String
  actorId        String
  developerActor Developer? @relation("AuditLogActorDeveloper", fields: [actorId], references: [id], onDelete: SetNull, map: "audit_log_actor_developer_fkey")
  action         String
  targetKind     String?
  targetId       String?
  payload        Json?
  ip             String?
  createdAt      DateTime   @default(now())

  @@index([actorType, actorId, createdAt])
  @@index([targetKind, targetId, createdAt])
}

model RegistryConsumer {
  id              String   @id @default(cuid())
  instanceId      String   @unique
  appId           String   @unique
  appKeyHash      String
  displayName     String
  enabled         Boolean  @default(true)
  rateLimitPerMin Int      @default(600)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model RegistrySetting {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RegistryLedgerEntry {
  id          String    @id @default(cuid())
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  amountCents Int
  currency    String    @default("CNY")
  reason      String
  externalRef String    @unique
  occurredAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  @@index([developerId, occurredAt])
  @@index([developerId, currency, occurredAt])
}

// =====================================================================
// Phase 3: Paid / License / Payout models
// =====================================================================

model PayoutAccount {
  id              String              @id @default(cuid())
  developerId     String
  developer       Developer           @relation(fields: [developerId], references: [id], onDelete: Cascade)
  accountType     String              // "bank_transfer", "paypal", etc.
  accountHolder   String
  accountNumber   String?             // Encrypted
  routingNumber   String?
  bankName        String?
  paypalEmail     String?
  status          PayoutAccountStatus @default(PENDING_VERIFICATION)
  verifiedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  payoutRequests PayoutRequest[]

  @@index([developerId, status])
}

model PayoutRequest {
  id              String       @id @default(cuid())
  payoutAccountId String
  payoutAccount   PayoutAccount @relation(fields: [payoutAccountId], references: [id], onDelete: Cascade)
  developerId     String
  developer       Developer    @relation(fields: [developerId], references: [id], onDelete: Cascade)
  amountCents     Int
  currency        String       @default("CNY")
  state           PayoutState  @default(PENDING_REVIEW)
  adminNote       String?      @db.Text
  processedAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([developerId, state])
  @@index([state, createdAt])
}

model Order {
  id              String        @id @default(cuid())
  orderNumber     String        @unique
  pluginId        String
  pluginSlug      String
  pluginRecordId  String?
  pluginRecord    PluginRecord? @relation(fields: [pluginRecordId], references: [id], onDelete: SetNull)
  developerId     String
  developer       Developer     @relation(fields: [developerId], references: [id], onDelete: Restrict)
  version         String
  buyerInstanceId String?       // NovaPay instance that purchased
  buyerMerchantId String?       // NovaPay merchant that purchased
  pricingPlanKind PricingPlanKind
  priceAmountCents Int
  priceCurrency   String        @default("CNY")
  state           OrderState    @default(PENDING)
  novapayOrderId  String?       // Reference to NovaPay order
  checkoutUrl     String?
  licenseId       String?
  paidAt          DateTime?
  failedAt        DateTime?
  refundedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  license License?

  @@index([pluginRecordId, state])
  @@index([pluginSlug, state])
  @@index([developerId, state])
  @@index([buyerInstanceId, state])
  @@index([buyerMerchantId, state])
}

model License {
  id              String        @id @default(cuid())
  licenseKey      String?       @unique
  licenseKeyHash  String        @unique
  orderId         String?       @unique
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  pluginId        String
  pluginSlug      String
  pluginRecordId  String?
  pluginRecord    PluginRecord? @relation(fields: [pluginRecordId], references: [id], onDelete: SetNull)
  developerId     String?
  developer       Developer?    @relation(fields: [developerId], references: [id], onDelete: SetNull)
  version         String
  pricingPlanKind PricingPlanKind
  issuedAt        DateTime      @default(now())
  expiresAt       DateTime?
  state           LicenseState  @default(ISSUED)
  jwsCompact      String        @db.Text
  instanceId      String?
  merchantId      String?

  revocation LicenseRevocation?

  @@index([pluginRecordId, state])
  @@index([pluginSlug, state])
  @@index([developerId, state])
}

model LicenseRevocation {
  id            String    @id @default(cuid())
  licenseId     String    @unique
  license       License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  reason        String
  revokedById   String
  revokedAt     DateTime  @default(now())
  note          String?   @db.Text

  @@index([revokedById, revokedAt])
}

// Extend PluginRecord with pricing history tracking
model PluginPricingHistory {
  id              String            @id @default(cuid())
  pluginId        String
  plugin          PluginRecord      @relation(fields: [pluginId], references: [id], onDelete: Cascade)
  pricingMode     PluginPricingMode
  pricingPlanKind PricingPlanKind?
  priceAmountCents Int?
  priceCurrency   String?
  changedById     String
  changedAt       DateTime          @default(now())
  beforeState     Json?
  afterState      Json?

  @@index([pluginId, changedAt])
}

// Add pricing fields to PluginRecord for PAID support
// (These will replace the current priceLabel field)
